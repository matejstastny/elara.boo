{
    "name": "elara-boo",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "prepare": "husky",
        "typecheck": "astro check"
    },
    "lint-staged": {
        "*.{astro,css,js,mjs,ts,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.{astro,js,mjs,ts}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "astro": "^7.3.4"
    },
    "allowScripts": {
        "esbuild": true
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.2.1",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.8",
        "prettier-plugin-astro": "^1.0.1"
    }
}
