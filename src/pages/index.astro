---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactRow from "../components/ContactRow.astro";
import Icon from "../components/Icon.astro";
import NameMark from "../components/NameMark.astro";
import Projects from "../components/Projects.astro";
import TechStrip from "../components/TechStrip.astro";
import Trickfire from "../components/Trickfire.astro";
import { education, footer, hero, identity, linux, name } from "../data/site";

const built = new Date().toISOString().slice(0, 10);
---

<BaseLayout>
    <a class="skip" href="#robotics">
        Skip to content
    </a>

    <!-- ---------- the whole first screen ---------- -->
    <section class="cover" id="top">
        <div class="shell cover-inner">
            <div class="cover-name">
                <NameMark />
                <p class="cover-role">
                    {hero.lines.map((line) => (
                        <span>{line}</span>
                    ))}
                </p>
            </div>

            <p class="cover-blurb">{hero.blurb}</p>

            <ContactRow />

            <TechStrip />
        </div>

        <a class="cue" href="#robotics">
            <span class="cue-label">scroll</span>
            <span class="cue-track" aria-hidden="true"></span>
            <span class="cue-dial" aria-hidden="true">
                <Icon class="cue-chevron" name="chevron" size={20} stroke={2} />
            </span>
        </a>
    </section>

    <main>
        <!-- ---------- trickfire ---------- -->
        <section class="shell band" id="robotics">
            <h2 class="label">robotics</h2>
            <div class="band-body">
                <Trickfire />
            </div>
        </section>

        <!-- ---------- personal projects ---------- -->
        <section class="shell band" id="projects">
            <h2 class="label">projects</h2>
            <div class="band-body">
                <p class="prose section-lede">
                    Things that did not exist the way I wanted them to, so I wrote them. Some are
                    finished, some are still arguments I am having with myself.
                </p>
                <Projects />
            </div>
        </section>

        <!-- ---------- linux & open source ---------- -->
        <section class="shell band" id="linux">
            <h2 class="label">linux</h2>
            <div class="band-body">
                <p class="prose">{linux.blurb}</p>

                <ul class="lx-links">
                    {linux.links.map((l) => (
                        <li>
                            <a href={l.href} rel="noreferrer" target="_blank">
                                <span class="lx-label">{l.label}</span>
                                <span class="lx-detail">{l.detail}</span>
                                <Icon class="lx-arrow" name="arrow" size={12} stroke={1.6} />
                            </a>
                        </li>
                    ))}
                </ul>

                <figure class="shot">
                    <img
                        alt={linux.alt}
                        decoding="async"
                        height="1664"
                        loading="lazy"
                        sizes="(max-width: 900px) 92vw, 760px"
                        src="/img/desktop-1100.webp"
                        srcset="/img/desktop-760.webp 760w, /img/desktop-1100.webp 1100w, /img/desktop-1600.webp 1600w"
                        width="2560"
                    />
                    <figcaption>{linux.caption}</figcaption>
                </figure>
            </div>
        </section>

        <!-- ---------- school ---------- -->
        <section class="shell band" id="school">
            <h2 class="label">school</h2>
            <div class="band-body">
                <div class="sch-head">
                    <h3 class="sch-title">{education.degree}</h3>
                    <p class="sch-sub">
                        {education.school} &middot; <span class="dimmed">{education.window}</span>
                    </p>
                </div>
                <ul class="facts sch-facts">
                    {education.facts.map(([k, v]) => (
                        <li>
                            <span class="k">{k}</span>
                            <span class="v">{v}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- ---------- elara ---------- -->
        <section class="shell band" id="elara">
            <h2 class="label">elara</h2>
            <div class="band-body">
                <p class="elara-line">
                    <Icon class="elara-glyph" moon="sparkle" size={14} />
                    <span>{identity.domain}</span>
                </p>
                <p class="prose">{name.body}</p>
            </div>
        </section>
    </main>

    <footer class="shell foot">
        <p>
            <span>built {built}</span>
            <span aria-hidden="true">&middot;</span>
            <a class="tlink" href={footer.source} rel="noreferrer" target="_blank">
                source
            </a>
        </p>
    </footer>

    <a class="totop" href="#top" aria-label="Back to top">
        <Icon name="up" size={15} stroke={1.7} />
    </a>

    <script is:inline>
        (() => {
            const btn = document.querySelector(".totop");
            if (!btn) return;
            const sync = () =>
                btn.classList.toggle("is-on", window.scrollY > window.innerHeight * 0.6);
            addEventListener("scroll", sync, { passive: true });
            sync();
        })();
    </script>
</BaseLayout>

<style>
    .skip {
        background: var(--surface);
        border-radius: 3px;
        color: var(--bright);
        font-size: 0.72rem;
        left: 10px;
        padding: 9px 14px;
        position: absolute;
        top: -100px;
        transition: top 140ms ease;
        z-index: 20;
    }

    .skip:focus {
        top: 10px;
    }

    /* ---------- cover ---------- */

    .cover {
        display: grid;
        grid-template-rows: 1fr auto;
        min-height: 100svh;
        padding-block: clamp(40px, 7vh, 76px) 0;
    }

    .cover-inner {
        align-content: center;
        display: grid;
        gap: clamp(22px, 3.4vh, 40px);
        width: 100%;
    }

    .cover-name {
        display: grid;
        gap: clamp(12px, 2vh, 22px);
    }

    .cover-role {
        color: var(--text);
        display: grid;
        font-size: clamp(0.78rem, 0.72rem + 0.24vw, 0.92rem);
        gap: 2px;
        letter-spacing: -0.01em;
        margin: 0;
    }

    .cover-role span:last-child {
        color: var(--dim);
        font-size: 0.92em;
    }

    .cover-blurb {
        color: var(--dim);
        font-size: clamp(0.8rem, 0.74rem + 0.26vw, 0.95rem);
        line-height: 1.7;
        margin: 0;
        max-width: 56ch;
    }

    /* ---------- scroll cue ---------- */

    .cue {
        align-items: center;
        align-self: center;
        color: var(--dim);
        display: flex;
        flex-direction: column;
        font-size: 0.66rem;
        gap: 10px;
        justify-self: center;
        letter-spacing: 0.2em;
        padding: clamp(18px, 3.5vh, 34px) 24px clamp(14px, 2.5vh, 26px);
        text-decoration: none;
        transition: color 220ms ease;
    }

    .cue:hover,
    .cue:focus-visible {
        color: var(--rose);
    }

    /* a hairline with a rose marker falling down it */
    .cue-track {
        background: linear-gradient(color-mix(in srgb, currentcolor 45%, transparent), transparent);
        border-radius: 2px;
        height: 30px;
        overflow: hidden;
        position: relative;
        width: 2px;
    }

    .cue-track::after {
        animation: fall 1.9s cubic-bezier(0.55, 0, 0.4, 1) infinite;
        background: var(--rose);
        border-radius: 2px;
        content: "";
        height: 14px;
        left: 0;
        position: absolute;
        top: -14px;
        width: 2px;
    }

    /* the target itself, same shape as the back-to-top button */
    .cue-dial {
        align-items: center;
        animation: nod 1.9s ease-in-out infinite;
        border: 1px solid var(--overlay);
        border-radius: 50%;
        display: flex;
        height: 40px;
        justify-content: center;
        transition:
            border-color 220ms ease,
            background-color 220ms ease;
        width: 40px;
    }

    .cue:hover .cue-dial,
    .cue:focus-visible .cue-dial {
        background: color-mix(in srgb, var(--rose) 10%, transparent);
        border-color: color-mix(in srgb, var(--rose) 60%, var(--overlay));
    }

    @keyframes fall {
        0% {
            top: -14px;
        }
        55%,
        100% {
            top: 30px;
        }
    }

    @keyframes nod {
        0%,
        45%,
        100% {
            transform: translateY(0);
        }
        68% {
            transform: translateY(6px);
        }
    }

    /* with motion off the marker cannot fall, so leave the track drawn instead */
    @media (prefers-reduced-motion: reduce) {
        .cue-track {
            background: linear-gradient(currentcolor, transparent);
        }

        .cue-track::after {
            content: none;
        }
    }

    /* ---------- linux links ---------- */

    .lx-links {
        border-top: var(--rule);
        list-style: none;
        margin: 0;
        max-width: 640px;
        padding: 0;
    }

    .lx-links li {
        border-bottom: var(--rule);
    }

    .lx-links a {
        align-items: baseline;
        color: var(--text);
        display: grid;
        gap: 4px 16px;
        grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) 12px;
        padding: 12px 0;
        text-decoration: none;
        transition: padding-left 220ms cubic-bezier(0.05, 0.7, 0.1, 1);
    }

    .lx-links a:hover {
        padding-left: 9px;
    }

    .lx-label {
        font-size: 0.78rem;
    }

    .lx-links a:hover .lx-label {
        color: var(--rose);
    }

    .lx-detail {
        color: var(--dim);
        font-size: 0.7rem;
    }

    .lx-arrow {
        color: var(--muted);
        transition:
            color 180ms ease,
            transform 220ms cubic-bezier(0.05, 0.7, 0.1, 1);
    }

    .lx-links a:hover .lx-arrow {
        color: var(--rose);
        transform: translate(2px, -2px);
    }

    /* ---------- screenshot ---------- */

    .shot {
        margin: 0;
        max-width: 800px;
    }

    .shot img {
        border: 1px solid var(--overlay);
        border-radius: 4px;
        display: block;
        height: auto;
        width: 100%;
    }

    .shot figcaption {
        color: var(--dim);
        font-size: 0.64rem;
        letter-spacing: 0.06em;
        padding-top: 11px;
    }

    /* ---------- school ---------- */

    .sch-title {
        color: var(--bright);
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.025em;
        margin: 0;
    }

    .sch-sub {
        color: var(--text);
        font-size: 0.74rem;
        margin: 4px 0 0;
    }

    .sch-facts {
        max-width: 52ch;
    }

    /* ---------- the name ---------- */

    .elara-line {
        align-items: center;
        color: var(--purple);
        display: flex;
        font-size: 0.86rem;
        font-weight: 600;
        gap: 9px;
        letter-spacing: 0.02em;
        margin: 0;
    }

    .elara-glyph {
        flex: none;
    }

    /* ---------- footer ---------- */

    .foot {
        border-top: var(--rule);
        padding-block: clamp(28px, 4vw, 44px) clamp(34px, 5vw, 60px);
    }

    .foot p {
        color: color-mix(in srgb, var(--dim) 78%, var(--base));
        display: flex;
        font-size: 0.64rem;
        gap: 9px;
        letter-spacing: 0.08em;
        margin: 0;
    }

    /* ---------- back to top ---------- */

    .totop {
        align-items: center;
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        backdrop-filter: blur(8px);
        border: 1px solid var(--overlay);
        border-radius: 50%;
        bottom: clamp(18px, 3vw, 30px);
        color: var(--dim);
        display: flex;
        height: 38px;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        position: fixed;
        right: clamp(18px, 3vw, 30px);
        transform: translateY(8px);
        transition:
            opacity 240ms ease,
            transform 240ms ease,
            color 180ms ease,
            border-color 180ms ease;
        width: 38px;
        z-index: 15;
    }

    .totop.is-on {
        opacity: 1;
        pointer-events: auto;
        transform: none;
    }

    .totop:hover {
        border-color: color-mix(in srgb, var(--rose) 55%, var(--overlay));
        color: var(--rose);
    }

    /* without the script the button never gets its class, so keep it reachable */
    @media (scripting: none) {
        .totop {
            opacity: 1;
            pointer-events: auto;
            transform: none;
        }
    }
</style>
