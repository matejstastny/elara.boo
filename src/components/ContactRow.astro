---
import Icon from "./Icon.astro";
import { contact } from "../data/site";
---

<ul class="contact" aria-label="Contact">
    {contact.links.map((l) => (
        <li>
            <a
                href={l.href}
                rel={
                    l.href.endsWith(".pdf")
                        ? "noopener"
                        : l.href.startsWith("/")
                          ? undefined
                          : "noreferrer me"
                }
                target={
                    l.href.endsWith(".pdf") ||
                    (!l.href.startsWith("/") && !l.href.startsWith("mailto:"))
                        ? "_blank"
                        : undefined
                }
            >
                <Icon name={l.icon} size={16} stroke={1.5} />
                <span class="c-label">{l.label}</span>
                <span class="c-handle">{l.handle}</span>
            </a>
        </li>
    ))}
</ul>

<style>
    .contact {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    a {
        align-items: center;
        border: 1px solid var(--overlay);
        border-radius: 999px;
        color: var(--text);
        display: inline-flex;
        gap: 8px;
        padding: 7px 15px 7px 13px;
        text-decoration: none;
        transition:
            border-color 180ms ease,
            color 180ms ease,
            background-color 180ms ease;
    }

    a:hover {
        background: color-mix(in srgb, var(--rose) 9%, transparent);
        border-color: color-mix(in srgb, var(--rose) 55%, var(--overlay));
        color: var(--bright);
    }

    .c-label {
        font-size: 0.74rem;
        letter-spacing: -0.01em;
    }

    /* the handle is the detail, only worth the room on a wide screen */
    .c-handle {
        border-left: 1px solid var(--overlay);
        color: var(--dim);
        font-size: 0.66rem;
        padding-left: 8px;
    }

    a:hover .c-handle {
        border-left-color: color-mix(in srgb, var(--rose) 40%, var(--overlay));
    }

    @media (max-width: 860px) {
        .c-handle {
            display: none;
        }

        a {
            padding: 7px 14px;
        }
    }
</style>
